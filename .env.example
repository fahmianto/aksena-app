# WhatsApp Business Cloud API credentials
# Get from: https://developers.facebook.com/apps/ > Your App > WhatsApp > API Setup

VITE_WA_PHONE_NUMBER_ID=your_phone_number_id_here
VITE_WA_TOKEN=your_permanent_access_token_here
VITE_WA_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# NOTE: VITE_ prefix is required for Vite to expose these to the frontend.
# For production, store WA_TOKEN only on the backend (never expose in browser).
